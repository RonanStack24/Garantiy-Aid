generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Barangay {
  barangayId   String        @id @default(uuid()) @map("barangay_id") @db.Uuid
  barangayCode String        @unique @map("barangay_code") @db.VarChar(32)
  barangayName String        @map("barangay_name") @db.VarChar(120)
  city         String        @db.VarChar(120)
  province     String        @db.VarChar(120)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  beneficiaries Beneficiary[]

  @@map("barangays")
}

model Beneficiary {
  beneficiaryId String         @id @default(uuid()) @map("beneficiary_id") @db.Uuid
  firstName     String         @map("first_name") @db.VarChar(100)
  middleName    String?        @map("middle_name") @db.VarChar(100)
  lastName      String         @map("last_name") @db.VarChar(100)
  birthDate     DateTime       @map("birth_date") @db.Date
  sex           String         @db.VarChar(32)
  address       String         @db.Text
  barangayId    String         @map("barangay_id") @db.Uuid
  contactNumber String         @unique @map("contact_number") @db.VarChar(20)
  email         String?        @unique @db.VarChar(254)
  passwordHash  String?        @map("password_hash") @db.VarChar(255)
  isVerified    Boolean        @default(false) @map("is_verified")
  philsysNumber String?        @unique @map("philsys_number") @db.VarChar(32)
  status        String         @default("pending") @db.VarChar(32)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  barangay      Barangay       @relation(fields: [barangayId], references: [barangayId])
  otpChallenges OtpChallenge[]
  authSessions  AuthSession[]

  @@index([barangayId])
  @@map("beneficiaries")
}

model OtpChallenge {
  challengeId      String      @id @default(uuid()) @map("challenge_id") @db.Uuid
  beneficiaryId    String      @map("beneficiary_id") @db.Uuid
  purpose          String      @db.VarChar(20)
  codeHash         String      @map("code_hash") @db.Char(64)
  attemptsRemaining Int        @default(5) @map("attempts_remaining")
  expiresAt        DateTime    @map("expires_at") @db.Timestamptz(6)
  consumedAt       DateTime?   @map("consumed_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  beneficiary      Beneficiary @relation(fields: [beneficiaryId], references: [beneficiaryId], onDelete: Cascade)

  @@index([beneficiaryId, purpose, createdAt])
  @@map("otp_challenges")
}

model AuthSession {
  sessionId     String      @id @default(uuid()) @map("session_id") @db.Uuid
  beneficiaryId String      @map("beneficiary_id") @db.Uuid
  tokenHash     String      @unique @map("token_hash") @db.Char(64)
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [beneficiaryId], onDelete: Cascade)

  @@index([beneficiaryId, expiresAt])
  @@map("auth_sessions")
}
